# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (SQLite)
DATABASE_URL="file:./dev.db"

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
MONITOR_RATE_LIMIT_MAX=30

# Anomaly detection thresholds (milliseconds; critical must be > warning)
THRESHOLD_WARNING_MS=3000
THRESHOLD_CRITICAL_MS=5000

# APIs in this comma-separated list may legitimately return 0 records
EMPTY_RESULT_ALLOWED_APIS=HealthCheckAPI,StatusAPI

# Request limits
MAX_BATCH_SIZE=50
MAX_BODY_SIZE_BYTES=262144

# Gemini AI (the only AI provider used)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# AI behaviour
AI_TIMEOUT_MS=15000
AI_MAX_CONCURRENT=2
AI_MAX_CALLS_PER_BATCH=10

# OpenAI is NOT used by this project (Gemini only). Fields kept for reference only.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
